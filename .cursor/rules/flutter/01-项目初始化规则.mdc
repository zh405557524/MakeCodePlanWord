## 四、推荐依赖基线

基础依赖通常包括：

- `get`
- `go_router`
- `dio`
- `package_info_plus`
- `flutter_localizations`
- `intl`
- `flutter_screenutil`（如采用移动端设计稿适配）

本地存储按项目选型补充：

- `shared_preferences`
- `get_storage`
- `hive`

全局提示按项目选一套：

- `bot_toast`
- `fluttertoast`
- 或自研 `CustomToast`

---

## 五、模板代码

### 5.1 `lib/main.dart`

```dart
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_localizations/flutter_localizations.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:your_project/global.dart';
import 'package:your_project/routes/index.dart';
import 'package:your_project/theme.dart';
import 'package:your_project/widgets/index.dart';

void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  SystemChrome.setSystemUIOverlayStyle(CustomTheme.systemStyleLight);
  await Global.init();
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp.router(
      title: '应用名称',
      theme: CustomTheme.light,
      themeMode: ThemeMode.light,
      localizationsDelegates: const [
        GlobalMaterialLocalizations.delegate,
        GlobalCupertinoLocalizations.delegate,
        GlobalWidgetsLocalizations.delegate,
      ],
      supportedLocales: const [
        Locale.fromSubtags(languageCode: 'zh'),
        Locale.fromSubtags(languageCode: 'en'),
      ],
      routerConfig: CustomRouter.config,
      builder: (context, child) {
        return MediaQuery(
          data: MediaQuery.of(context),
          child: Builder(
            builder: (innerContext) {
              ScreenUtil.init(
                innerContext,
                designSize: const Size(375, 812),
                minTextAdapt: true,
                splitScreenMode: true,
              );

              return CustomToast.init(
                context: innerContext,
                builder: (context, child) => MediaQuery(
                  data: MediaQuery.of(context).copyWith(
                    textScaler: TextScaler.noScaling,
                  ),
                  child: child ?? const Material(),
                ),
              )(innerContext, child);
            },
          ),
        );
      },
    );
  }
}
```

### 5.2 `lib/global.dart`

```dart
import 'package:get/get.dart';
import 'package:package_info_plus/package_info_plus.dart';
import 'package:your_project/services/index.dart';
import 'package:your_project/store/index.dart';

class Global {
  Global._();

  static PackageInfo? _platform;

  static String get version => _platform?.version ?? '0.0.0';
  static String get build => _platform?.buildNumber ?? '0';
  static String get appName => _platform?.appName ?? '-';

  static Future<void> init() async {
    _platform = await PackageInfo.fromPlatform();

    await Get.putAsync<StorageService>(() => StorageService().init());

    Get.put<EventService>(EventService());
    Get.put<HttpService>(HttpService());
    Get.put<ConfigStore>(ConfigStore());
    Get.put<UserStore>(UserStore());
  }
}
```

