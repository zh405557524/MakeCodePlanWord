    │   ├── requirements.md          # 需求文档（PRD）
    │   ├── requirements-review.md   # 产品负责人快速审核层；不是需求真源或检测报告
    │   ├── detection-feedback.md    # 检测阶段用户指出问题与关注点的累计记录
    │   ├── figma-design-plan.md     # Figma 设计稿计划
    │   └── references/
    │       ├── README.md
    │       ├── images/
    │       └── docs/
    ├── 02-技术方案/
    │   ├── tech-plan.md             # 技术方案
    │   └── effort-estimate.md       # 工作时长评估
    ├── 03-前端/
    │   ├── flutter-tech.md
    │   ├── flutter-dev-plan.md
    │   └── 开发计划/
    ├── 04-后端/
    │   ├── java-tech.md
    │   ├── java-dev-plan.md / kotlin-dev-plan.md
    │   └── 开发计划/
    ├── 05-联调与测试/
    │   └── qa-plan.md
    ├── 06-构建打包/
    │   ├── build-plan.md
    │   ├── android.md
    │   └── ios.md
