## 五、测试

### 5.1 集成测试

```kotlin
class UserRoutesTest {
    @Test
    fun `create user returns 0 on success`() = testApplication {
        application { module() }

        val response = client.post("/api/users") {
            contentType(ContentType.Application.Json)
            setBody("""{"username":"alice","email":"a@b.com","password":"123456"}""")
        }
        assertEquals(HttpStatusCode.OK, response.status)
        // 进一步断言 ApiResponse.code == 0
    }
}
```

### 5.2 单元测试（Service）

```kotlin
class UserServiceTest {
    @Test
    fun `create user fails on duplicate email`() = runTest {
        val repo = mockk<UserRepository>()
        coEvery { repo.findByEmail("a@b.com") } returns User(id = "x", ...)

        val service = UserService(repo)
        val ex = assertFailsWith<BusinessException> {
            service.create(CreateUserRequest("alice", "a@b.com", "123456"))
        }
        assertEquals(2001, ex.code)
    }
}
```

